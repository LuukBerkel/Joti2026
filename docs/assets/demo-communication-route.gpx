  <metadata>
    <name>Demo communicatiepuzzel</name>
    <desc>Illustratieve voorbeeldroute. Niet gebruiken voor navigatie.</desc>
  </metadata>
  <wpt lat="52.0908" lon="5.1214">
    <name>Vraag 1 - Morsecode</name>
    <desc>Vraag: Welke code bestaat uit korte en lange signalen? Puzzelstukje: DIGI</desc>
  </wpt>
  <wpt lat="52.0914" lon="5.1230">
    <name>Vraag 2 - Spellen</name>
    <desc>Vraag: Welk alfabet helpt om letters in een callsign duidelijk door te geven? Puzzelstukje: TAL</desc>
  </wpt>
  <wpt lat="52.0901" lon="5.1242">
    <name>Vraag 3 - Radio</name>
    <desc>Vraag: Hoe heet het aantal trillingen per seconde van een radiosignaal? Puzzelstukje: PHYSI</desc>
  </wpt>
  <wpt lat="52.0894" lon="5.1225">
    <name>Vraag 4 - JOTI</name>
    <desc>Vraag: Waar staat de I in JOTI voor? Puzzelstukje: CAL</desc>
  </wpt>
  <trk>
    <name>Demo communicatiepuzzel</name>
